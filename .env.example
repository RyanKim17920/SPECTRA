# ======================================================================================
# SPECTRA path roots -- copy to `.env` and edit for your machine.
# ======================================================================================
#
# `.env` is read by src/waivphaet/paths.py (Python) and scripts/_env.sh (shell/sbatch).
# It is gitignored: it describes ONE machine, and the repo must not carry anyone's home
# directory.  A variable already set in your real environment always wins over this file,
# so `SPECTRA_RUNS=/tmp/x python scripts/final_scoreboard.py` overrides it for one run.
#
# Nothing here has to exist before you start.  Only the roots a given script actually
# touches matter, and every one has a repo-relative default -- an unset variable is not
# an error, a missing corpus is (reported by the script that needed it).
#
# Print the resolved values at any time:
#     ./.venv/bin/python scripts/_config.py

# The checkout. Auto-detected from the source file; set it only if you run scripts from
# a copy, or submit sbatch jobs from outside the repo root.
#SPECTRA_REPO=/path/to/spectra

# Training runs: checkpoints, ri_curve.json, per-benchmark summaries. These get large
# (tens of GB per run), so this usually points at scratch, not at the checkout.
# Default: <repo>/runs
#SPECTRA_RUNS=/scratch/you/spectra_runs

# The one root everything else below defaults under. Set this alone and the corpora,
# caches and harness outputs follow it.
# Default: <repo>/data_root
SPECTRA_DATA=/scratch/you

# PLISM co-registered corpus (raw .h5 from HuggingFace) and the repacked tiles that
# training actually reads (scripts/acquire_plism.py writes both).
# Defaults: <data>/plism and <plism>/repacked
#SPECTRA_PLISM=/scratch/you/plism
#SPECTRA_PLISM_PACKED=/scratch/you/plism/repacked

# THUNDER's own THUNDER_BASE_DATA_FOLDER. Holds datasets/ and outputs/.
# Default: <data>/thunder
#SPECTRA_THUNDER=/scratch/you/thunder

# HEST-benchmark: the downloaded benchmark data, and the work dir the runner writes
# embeddings/ and results/ into.
# Defaults: <data>/hest_bench and <data>/hest_work
#SPECTRA_HEST_BENCH=/scratch/you/hest_bench
#SPECTRA_HEST_WORK=/scratch/you/hest_work

# Output root of the per-checkpoint "cell" eval harness (pathorob/, thunder/, hest/,
# cptac/ subtrees). Most of the table generators read from here.
# Default: <data>/full-evals
#SPECTRA_EVALS=/scratch/you/full-evals

# HuggingFace cache. Set it: the ~/.cache default will fill a home volume with
# multi-GB backbones.
# Default: <data>/huggingface
#SPECTRA_HF_HOME=/scratch/you/huggingface

# Root holding locally-served base-model weight directories, one subdirectory per
# backbone (see waivphaet/models/backbones.py `local_subdir`). Gated repos -- H-optimus-0,
# UNI2-h, Virchow v1 -- 403 on every hub call and can only be served from here.
# Default: <data>/inputs
#SPECTRA_INPUTS=/scratch/you/model-weights

# One directory per evaluated checkpoint, each with its own model.py. Only needed if you
# run the cell harness (scripts/eval_matrix.py, seed_stats.py and the rank tables).
# Default: <repo>/cells
#SPECTRA_CELLS=/path/to/cells

# LaTeX source tree the table and figure generators write into: <paper>/tables/*.tex and
# <paper>/figures/*.pdf. Point it at your paper repo, or leave it and the tables land in
# <repo>/paper.
# Default: <repo>/paper
#SPECTRA_PAPER=/path/to/paper

# Frozen code snapshots a run was pinned to (WAIV_PIN / the pin checks in the sbatch
# scripts), and durable copies of result JSON that otherwise live only on scratch.
# Defaults: <repo>/snapshots and <repo>/result_backups
#SPECTRA_SNAPSHOTS=/path/to/snapshots
#SPECTRA_BACKUPS=/path/to/result_backups
