+def knn_predict(train_embs, train_labels, query_embs, k_vals):
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    train = F.normalize(torch.from_numpy(np.asarray(train_embs)).float(), dim=1).to(device)
+    query = F.normalize(torch.from_numpy(np.asarray(query_embs)).float(), dim=1).to(device)
+    labels = torch.as_tensor(np.asarray(train_labels)).long().to(device)
+    nb_classes = int(labels.max().item()) + 1
+    top = torch.empty(len(query), max(k_vals), dtype=torch.long, device=device)
+    for start in range(0, len(query), 1024):
+        top[start : start + 1024] = (
+            query[start : start + 1024] @ train.T
+        ).topk(max(k_vals), dim=1).indices
+    return {
+        k: F.one_hot(labels[top[:, :k]], nb_classes).sum(1).argmax(1).cpu().numpy()
+        for k in k_vals
+    }
+
